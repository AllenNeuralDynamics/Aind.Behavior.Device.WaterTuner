        "subject": {
          "description": "Name of the subject",
          "title": "Subject",
          "type": "string"
        },
        "experiment_version": {
          "description": "Version of the experiment",
          "title": "Experiment Version",
          "type": "string"
        },
        "notes": {
          "default": null,
          "description": "Notes about the experiment",
